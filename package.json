{
  "name": "cs-lexicon",
  "version": "1.0.0",
  "description": "Bilgisayar mühendisliği için akademik İngilizce kelime, örnek cümle ve Türkçe çeviri uygulaması",
  "main": "electron/main.js",
  "author": "CS Lexicon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cslexicon.app",
    "productName": "CS Lexicon",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "data.js",
      "app.js",
      "manifest.json",
      "sw.js",
      "icons/**/*",
      "electron/**/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CS-Lexicon-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CS-Lexicon-Portable-${version}-win-${arch}.${ext}"
    }
  }
}
